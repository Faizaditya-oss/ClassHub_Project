<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

    <% if (dbError) { %>
      <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">
        Gagal mengambil data profil kelas dari database. Silakan periksa koneksi PostgreSQL dan coba lagi.
      </div>
    <% } %>

    <% if (!classInfo) { %>
      <div class="bg-white rounded-2xl p-10 border border-slate-200/80 shadow-sm text-center">
        <h1 class="text-2xl font-bold text-slate-900 mb-2">Data Profil Kelas Belum Tersedia</h1>
        <p class="text-slate-600 text-sm">
          Tabel <span class="font-mono text-slate-800">class_profiles</span> masih kosong. Jalankan
          <span class="font-mono text-slate-800">npm run db:init</span> untuk mengisi data awal.
        </p>
      </div>
    <% } else { %>
    
    <!-- Header Title -->
    <div class="border-b border-slate-200 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold mb-3">
        Profil & Identitas
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Profil Kelas <%= classInfo.shortName %>
      </h1>
      <p class="text-slate-600 mt-2 text-base max-w-3xl">
        Mengenal lebih dekat visi, misi, budaya belajar, dan struktur kepengurusan Kelas <%= classInfo.name %>.
      </p>
    </div>

    <!-- Overview Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Deskripsi Kelas -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm space-y-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-600"></span>
            Tentang Kelas Kami
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            <%= classInfo.description %>
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/70">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Motto Kelas</p>
          <p class="text-base font-semibold text-brand-800 italic">
            "<%= classInfo.tagline %>"
          </p>
        </div>

        <div class="space-y-4 pt-2">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">Nilai Budaya Belajar</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-lg border border-slate-100 bg-white">
              <span class="font-bold text-slate-800 text-sm block">1. Saling Mendukung</span>
              <span class="text-xs text-slate-500">Berbagi catatan kuliah, tutorial materi sulit, dan kerja tim solid.</span>
            </div>
            <div class="p-3.5 rounded-lg border border-slate-100 bg-white">
              <span class="font-bold text-slate-800 text-sm block">2. Inovatif & Berani Coba</span>
              <span class="text-xs text-slate-500">Mengeksplorasi tools dan teknologi modern di luar kurikulum wajib.</span>
            </div>
            <div class="p-3.5 rounded-lg border border-slate-100 bg-white">
              <span class="font-bold text-slate-800 text-sm block">3. Disiplin & Tanggung Jawab</span>
              <span class="text-xs text-slate-500">Tepat waktu dalam tugas dan komitmen terhadap kesepakatan bersama.</span>
            </div>
            <div class="p-3.5 rounded-lg border border-slate-100 bg-white">
              <span class="font-bold text-slate-800 text-sm block">4. Komunikasi Terbuka</span>
              <span class="text-xs text-slate-500">Transparansi kas, jadwal, dan forum musyawarah berkala.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Info Meta Card -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
          <h3 class="text-base font-bold text-slate-900 pb-4 border-b border-slate-100">
            Informasi Ringkas Kelas
          </h3>

          <dl class="divide-y divide-slate-100 text-sm">
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Program Studi</dt>
              <dd class="font-medium text-slate-800 text-right">Teknik Informatika</dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Kode / Nama Kelas</dt>
              <dd class="font-semibold text-brand-700 text-right"><%= classInfo.shortName %></dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Tahun Angkatan</dt>
              <dd class="font-medium text-slate-800 text-right">2024</dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Periode Akademik</dt>
              <dd class="font-medium text-slate-800 text-right"><%= classInfo.academicYear %></dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Dosen Pembina / Wali</dt>
              <dd class="font-medium text-slate-800 text-right"><%= classInfo.homeroomTeacher %></dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Ketua & Wakil</dt>
              <dd class="font-medium text-slate-800 text-right"><%= classInfo.leader %> &bull; <%= classInfo.viceLeader %></dd>
            </div>
            <div class="py-3 flex justify-between">
              <dt class="text-slate-500">Jumlah Mahasiswa</dt>
              <dd class="font-bold text-slate-900 text-right"><%= classInfo.totalStudents %> Orang</dd>
            </div>
          </dl>
        </div>

        <!-- Saluran Komunikasi -->
        <div class="bg-gradient-to-br from-brand-900 to-slate-900 rounded-2xl p-6 text-white shadow-md">
          <h3 class="font-bold text-sm tracking-wider uppercase text-brand-300 mb-3">Saluran Informasi Resmi</h3>
          <p class="text-xs text-slate-300 mb-4 leading-relaxed">
            Terhubung dengan kanal resmi untuk pengumuman terkini, notulensi rapat, dan repositori proyek:
          </p>
          <div class="space-y-2 text-xs">
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/10">
              <span class="text-slate-300">Instagram:</span>
              <span class="font-semibold text-white"><%= classInfo.socials.instagram %></span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/10">
              <span class="text-slate-300">GitHub Org:</span>
              <span class="font-semibold text-white"><%= classInfo.socials.github %></span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/10">
              <span class="text-slate-300">Email Koordinator:</span>
              <span class="font-semibold text-white"><%= classInfo.socials.email %></span>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Visi dan Misi Section -->
    <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-brand-600 uppercase tracking-widest">Arah & Tujuan</span>
        <h2 class="text-2xl font-bold text-slate-900 mt-1 mb-8">Visi dan Misi Kelas</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Visi Card -->
        <div class="lg:col-span-5 p-6 rounded-2xl bg-gradient-to-br from-brand-50 to-blue-50 border border-brand-100 flex flex-col justify-between">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-brand-600 text-white text-xs font-bold mb-4">
              VISI UTAMA
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Visi Kelas</h3>
            <p class="text-slate-700 leading-relaxed text-sm">
              "<%= classInfo.vision %>"
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-brand-200/60 text-xs text-brand-800 font-medium">
            Komitmen terarah untuk pencapaian keunggulan bersama.
          </div>
        </div>

        <!-- Misi List -->
        <div class="lg:col-span-7 space-y-4">
          <h3 class="text-base font-bold text-slate-900">Misi Pelaksanaan</h3>
          
          <div class="space-y-3">
            <% classInfo.missions.forEach((mission, index) => { %>
              <div class="flex items-start gap-4 p-4 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition-colors">
                <div class="w-7 h-7 rounded-lg bg-brand-600 text-white flex-shrink-0 flex items-center justify-center font-bold text-xs mt-0.5">
                  <%= index + 1 %>
                </div>
                <p class="text-sm text-slate-700 leading-relaxed">
                  <%= mission %>
                </p>
              </div>
            <% }) %>
          </div>

        </div>

      </div>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
