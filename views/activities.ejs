<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

    <% if (dbError) { %>
      <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700">
        Gagal mengambil data kegiatan dari database. Silakan periksa koneksi PostgreSQL dan coba lagi.
      </div>
    <% } %>
    
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-slate-200 pb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold mb-3">
          Agenda & Arsip
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Kegiatan & Dokumentasi Kelas
        </h1>
        <p class="text-slate-600 mt-2 text-base">
          Rekam jejak program kerja, sesi belajar kelompok, dan momen kebersamaan kelas.
        </p>
      </div>

      <div class="flex items-center gap-3 bg-white p-3 px-5 rounded-2xl border border-slate-200 shadow-sm self-start md:self-auto">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <span class="text-xl font-extrabold text-slate-900 block leading-tight"><%= totalActivities %></span>
          <span class="text-xs text-slate-500 font-medium">Total Agenda</span>
        </div>
      </div>
    </div>

    <% if (activities.length === 0) { %>
      <div class="bg-white rounded-2xl p-10 border border-slate-200/80 shadow-sm text-center">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Belum Ada Data Kegiatan</h2>
        <p class="text-slate-600 text-sm">
          Tabel <span class="font-mono text-slate-800">activities</span> masih kosong. Jalankan
          <span class="font-mono text-slate-800">npm run db:init</span> untuk mengisi data awal.
        </p>
      </div>
    <% } else { %>
    <!-- Activities List / Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% activities.forEach(act => { %>
        <article class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col group">
          
          <!-- Image Documentation -->
          <div class="relative h-60 sm:h-64 overflow-hidden bg-slate-100">
            <img src="<%= act.image %>" alt="<%= act.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>

            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              <span class="bg-white/95 backdrop-blur-md text-brand-700 text-xs font-bold px-3 py-1 rounded-lg border border-slate-100 shadow-sm">
                <%= act.category %>
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs">
              <div class="flex items-center gap-1.5 font-medium">
                <svg class="w-4 h-4 text-brand-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span><%= act.date %></span>
              </div>
              
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold <%= act.status === 'Selesai' ? 'bg-emerald-500/90 text-white' : 'bg-amber-500/90 text-white' %>">
                <%= act.status %>
              </span>
            </div>
          </div>

          <!-- Content Body -->
          <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
            <div>
              <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2 leading-snug">
                <%= act.title %>
              </h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                <%= act.description %>
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 space-y-1.5 text-xs text-slate-500">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span><strong>Waktu:</strong> <%= act.time %></span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span><strong>Lokasi:</strong> <%= act.location %></span>
              </div>
            </div>
          </div>

        </article>
      <% }) %>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
