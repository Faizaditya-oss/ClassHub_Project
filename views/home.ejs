<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow">
  <%
    const info = classInfo || {
      name: 'Data kelas belum tersedia',
      shortName: 'â€”',
      tagline: 'Data kelas belum tersedia',
      academicYear: '-',
      semester: '-',
      homeroomTeacher: '-',
      leader: '-',
      viceLeader: '-',
      totalStudents: 0,
      totalActivities: 0,
      activeProjects: 0,
      achievements: 0,
      description: '',
      vision: '',
      missions: [],
      socials: {}
    };
  %>

  <% if (dbError || !classInfo) { %>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <div class="p-4 rounded-xl <%= dbError ? 'bg-red-50 border-red-200 text-red-700' : 'bg-slate-100 border-slate-200 text-slate-600' %> border text-sm">
        <%= dbError
          ? 'Gagal mengambil data dari database. Silakan periksa koneksi PostgreSQL dan coba lagi.'
          : 'Data kelas belum tersedia di database. Jalankan npm run db:init untuk mengisi data awal.' %>
      </div>
    </div>
  <% } %>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 via-white to-slate-50 border-b border-slate-200/60 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Text Hero -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-100/70 border border-brand-200 text-brand-800 text-xs font-semibold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-brand-600 animate-ping"></span>
            Selamat Datang di Portal Resmi Kelas
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
            Sinergi Cerdas, <br class="hidden sm:inline">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-sky-500">
              Generasi Berprestasi
            </span>
          </h1>

          <p class="text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
            <%= info.tagline %>. Wadah komunikasi terpadu, arsip kegiatan, dan pendamping belajar berbasis AI untuk seluruh civitas kelas <%= info.shortName %>.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
            <a href="/profile" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-center shadow-lg shadow-brand-600/20 hover:shadow-xl transition-all">
              Jelajahi Profil Kelas
            </a>
            <a href="/chat" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-semibold border border-slate-200 shadow-sm transition-all">
              <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              Tanya AI Assistant
            </a>
          </div>

          <!-- Mini Badges -->
          <div class="pt-6 border-t border-slate-200/70 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Arsitektur MVC Terstandarisasi</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Desain Responsif & Modern</span>
            </div>
          </div>

        </div>

        <!-- Hero Card / Quick Glance -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-md bg-white rounded-3xl p-6 sm:p-8 shadow-xl shadow-brand-900/5 border border-slate-200/80">
            
            <div class="flex items-center justify-between pb-6 border-b border-slate-100">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-200 flex items-center justify-center text-brand-600 font-bold text-lg">
                  TI
                </div>
                <div>
                  <h3 class="font-bold text-slate-900"><%= info.shortName %></h3>
                  <p class="text-xs text-slate-500">Angkatan 2024</p>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Aktif
              </span>
            </div>

            <div class="py-5 space-y-3.5 text-sm">
              <div class="flex justify-between items-center py-1 border-b border-slate-50">
                <span class="text-slate-500">Tahun Akademik</span>
                <span class="font-semibold text-slate-800"><%= info.academicYear %></span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-50">
                <span class="text-slate-500">Semester</span>
                <span class="font-semibold text-slate-800"><%= info.semester %></span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-slate-50">
                <span class="text-slate-500">Dosen Pembimbing</span>
                <span class="font-semibold text-slate-800 text-right"><%= info.homeroomTeacher %></span>
              </div>
              <div class="flex justify-between items-center py-1">
                <span class="text-slate-500">Ketua Kelas</span>
                <span class="font-semibold text-brand-700"><%= info.leader %></span>
              </div>
            </div>

            <!-- Fast Action Banner -->
            <div class="mt-4 p-4 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-700 text-white flex items-center justify-between">
              <div>
                <p class="text-xs text-brand-200 font-medium">Asisten Cerdas Kelas</p>
                <p class="text-sm font-bold">Butuh info jadwal atau tugas?</p>
              </div>
              <a href="/chat" class="px-3 py-1.5 bg-white text-brand-700 text-xs font-bold rounded-lg hover:bg-brand-50 transition-colors">
                Mulai Chat
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Statistik Section -->
  <section class="py-12 bg-white border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-brand-200 transition-colors text-center sm:text-left">
          <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center mb-3 mx-auto sm:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="text-3xl font-extrabold text-slate-900"><%= stats.totalStudents %></div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1">Total Anggota</p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-brand-200 transition-colors text-center sm:text-left">
          <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center mb-3 mx-auto sm:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="text-3xl font-extrabold text-slate-900"><%= stats.totalActivities %></div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1">Kegiatan Kelas</p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-brand-200 transition-colors text-center sm:text-left">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center mb-3 mx-auto sm:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="text-3xl font-extrabold text-slate-900"><%= stats.activeProjects %></div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1">Proyek Bersama</p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-brand-200 transition-colors text-center sm:text-left">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center mb-3 mx-auto sm:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div class="text-3xl font-extrabold text-slate-900"><%= stats.achievements %></div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1">Penghargaan & Prestasi</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Ringkasan Informasi Kelas Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-xs font-bold text-brand-600 uppercase tracking-widest mb-2">Pilar & Nilai Kelas</h2>
        <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">Fondasi Utama Komunitas Kami</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Kolaborasi Aktif</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Menumbuhkan suasana belajar yang terbuka melalui kelompok studi, mentoring sesama mahasiswa, dan keterbukaan informasi.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Eksplorasi Teknologi</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Fokus mengasah kemampuan praktis pemrograman, cloud computing, arsitektur data, dan integrasi Artificial Intelligence.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Integritas & Etika</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Menjunjung tinggi kejujuran akademik, etika profesionalisme rekayasa software, dan kontribusi positif terhadap lingkungan sekitar.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Cuplikan Kegiatan Terkini -->
  <section class="py-16 bg-white border-t border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <h2 class="text-xs font-bold text-brand-600 uppercase tracking-widest mb-2">Dokumentasi & Agenda</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">Kegiatan Terbaru Kelas</p>
        </div>
        <a href="/activities" class="mt-4 sm:mt-0 text-sm font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1.5 group">
          Lihat Semua Kegiatan
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <% if (recentActivities.length === 0) { %>
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 text-center text-sm text-slate-600">
          Belum ada kegiatan yang tersimpan di database.
        </div>
      <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% recentActivities.forEach(act => { %>
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col">
            <div class="h-44 overflow-hidden relative">
              <img src="<%= act.image %>" alt="<%= act.title %>" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-xs font-semibold px-2.5 py-1 rounded-md text-brand-700 border border-slate-200">
                <%= act.category %>
              </span>
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="text-xs font-medium text-slate-400 mb-2"><%= act.date %></div>
              <h3 class="text-base font-bold text-slate-900 mb-2 line-clamp-2"><%= act.title %></h3>
              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mb-4 flex-grow"><%= act.description %></p>
              <div class="pt-3 border-t border-slate-100 text-xs font-semibold text-brand-600">
                Lokasi: <%= act.location %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <% } %>

    </div>
  </section>
</main>

<%- include('partials/footer') %>
