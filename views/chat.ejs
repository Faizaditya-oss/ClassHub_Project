<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-grow py-8 bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Chat Card Container -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden flex flex-col h-[750px] max-h-[85vh]">
      
      <!-- Chat Header -->
      <div class="p-4 sm:px-6 py-4 bg-gradient-to-r from-brand-700 via-brand-600 to-sky-600 text-white flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold">ClassHub AI Assistant</h1>
              <span class="text-[10px] bg-white/20 font-medium px-2 py-0.5 rounded-full uppercase tracking-wider">Tahap 1: Demo Placeholder</span>
            </div>
            <p class="text-xs text-brand-100">Siap menjawab pertanyaan seputar informasi dan profil kelas</p>
          </div>
        </div>

        <div class="hidden sm:flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-100 text-xs font-semibold border border-emerald-400/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Sistem Aktif
          </span>
        </div>
      </div>

      <!-- Notice Banner on Placeholder Mode -->
      <div class="bg-amber-50 border-b border-amber-200/60 px-4 py-2.5 text-xs text-amber-800 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <span><strong>Informasi:</strong> Saat ini bot berjalan menggunakan respons engine placeholder. Google Gemini API akan dihubungkan pada tahap selanjutnya.</span>
        </div>
      </div>

      <!-- Chat Messages Scroll Area -->
      <div id="chatMessages" class="flex-grow p-4 sm:p-6 overflow-y-auto space-y-4 bg-slate-50/50">
        
        <% initialMessages.forEach(msg => { %>
          <div class="flex items-start gap-3 max-w-2xl">
            <div class="w-8 h-8 rounded-xl bg-brand-600 text-white flex-shrink-0 flex items-center justify-center font-bold text-xs shadow-sm">
              AI
            </div>
            <div class="space-y-1">
              <div class="bg-white p-4 rounded-2xl rounded-tl-none border border-slate-200/80 shadow-sm text-sm text-slate-800 leading-relaxed whitespace-pre-line">
                <%= msg.text %>
              </div>
              <span class="text-[10px] text-slate-400 block px-1"><%= msg.timestamp %></span>
            </div>
          </div>
        <% }) %>

      </div>

      <!-- Suggested Quick Questions -->
      <div class="px-4 sm:px-6 py-2.5 bg-white border-t border-slate-100 flex items-center gap-2 overflow-x-auto text-xs no-scrollbar">
        <span class="text-slate-400 font-medium whitespace-nowrap flex-shrink-0">Saran Pertanyaan:</span>
        <button type="button" class="quick-prompt px-3 py-1 rounded-full bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-600 transition-colors whitespace-nowrap border border-slate-200/60">
          Siapa ketua kelas?
        </button>
        <button type="button" class="quick-prompt px-3 py-1 rounded-full bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-600 transition-colors whitespace-nowrap border border-slate-200/60">
          Apa profil dan visi kelas?
        </button>
        <button type="button" class="quick-prompt px-3 py-1 rounded-full bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-600 transition-colors whitespace-nowrap border border-slate-200/60">
          Ada kegiatan apa saja?
        </button>
        <button type="button" class="quick-prompt px-3 py-1 rounded-full bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-600 transition-colors whitespace-nowrap border border-slate-200/60">
          Berapa jumlah anggota kelas?
        </button>
      </div>

      <!-- Chat Input Area -->
      <div class="p-4 sm:px-6 bg-white border-t border-slate-200">
        <form id="chatForm" class="flex items-center gap-2">
          <input 
            type="text" 
            id="chatInput" 
            placeholder="Ketik pertanyaan seputar profil atau informasi kelas..." 
            autocomplete="off"
            class="flex-grow px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm placeholder-slate-400"
          >
          <button 
            type="submit" 
            id="sendBtn"
            class="px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm flex items-center gap-2 shadow-sm transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span>Kirim</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>

    </div>

  </div>
</main>

<script src="/js/chat.js"></script>
<%- include('partials/footer') %>
